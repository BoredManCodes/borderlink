<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BorderLink.Desktop.UI.ViewModels"
		xmlns:fakes="clr-namespace:BorderLink.Desktop.UI.ViewModels.Fakes"
        xmlns:Models="clr-namespace:BorderLink.Shared.Models;assembly=Shared"
        mc:Ignorable="d"
		d:DesignWidth="480" d:DesignHeight="500"
        x:Class="BorderLink.Desktop.UI.Views.ChatWindow"
        Icon="{Binding WindowIcon}"
        BorderBrush="{DynamicResource BlInk}"
        BorderThickness="1"
        MinHeight="280"
		x:CompileBindings="True"
        MinWidth="320"
        Topmost="True"
		ShowActivated="True"
		x:DataType="vm:IChatWindowViewModel"
		x:Name="ChatWindowRef"
        Title="Chat Session"
		Height="500" Width="480">

	<Design.DataContext>
		<fakes:FakeChatWindowViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto, *" Margin="18,14,18,14">

		<StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,10">
			<TextBlock Classes="Kicker" Text="§ &#160;Chat session" />
			<TextBlock Text="{Binding ChatSessionHeader}"
					   Classes="SectionHeader"
					   FontSize="18"
					   TextWrapping="Wrap" />
			<Rectangle Classes="BorderLine" Margin="0,8,0,0" />
		</StackPanel>

		<Grid Grid.Row="1" RowDefinitions="*, 6, 64">

			<Border Grid.Row="0"
					Classes="Card"
					Padding="2">
				<ScrollViewer x:Name="MessagesScrollViewer">
					<ItemsControl x:Name="MessagesListBox"
								  ItemsSource="{Binding ChatMessages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate DataType="{x:Type Models:ChatMessage}">
								<Grid Margin="8,5" ColumnDefinitions="Auto, 6, *">
									<TextBlock Grid.Column="0"
											   Text="{Binding SenderName}"
											   FontWeight="Bold"
											   FontSize="14"
											   Foreground="{DynamicResource BlInk}"
											   TextWrapping="Wrap">
										<TextBlock.Styles>
											<Style Selector="TextBlock[Text=You]">
												<Setter Property="Foreground" Value="{DynamicResource BlRedDark}" />
												<Setter Property="FontStyle" Value="Italic" />
											</Style>
										</TextBlock.Styles>
									</TextBlock>
									<TextBlock Grid.Column="2"
											   Text="{Binding Message}"
											   TextWrapping="Wrap"
											   FontSize="14"
											   Foreground="{DynamicResource BlInkSoft}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>

			<GridSplitter Grid.Row="1"
						  Height="6"
						  Background="{DynamicResource BlPaperEdge}"
						  VerticalAlignment="Stretch"
						  HorizontalAlignment="Stretch" />

			<TextBox Grid.Row="2"
					 x:Name="InputTextBox"
					 FontSize="14"
					 Padding="10,8"
					 Text="{Binding InputText, Mode=TwoWay}"
					 TextWrapping="Wrap"
					 AcceptsReturn="True"
					 Watermark="Type a message…" />
		</Grid>
	</Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BorderLink.Desktop.UI.ViewModels"
		xmlns:fakes="clr-namespace:BorderLink.Desktop.UI.ViewModels.Fakes"
        mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="100"
        Width="320"
        Height="100"
        x:Class="BorderLink.Desktop.UI.Views.SessionIndicatorWindow"
		x:DataType="vm:ISessionIndicatorWindowViewModel"
        Title="{Binding ProductName}"
        Icon="{Binding WindowIcon}"
        WindowStartupLocation="Manual"
        Topmost="True"
        SizeToContent="WidthAndHeight">

	<Design.DataContext>
		<fakes:FakeSessionIndicatorWindowViewModel />
	</Design.DataContext>

	<Border BorderBrush="{DynamicResource BlRed}"
			BorderThickness="0,2,0,0"
			Background="{DynamicResource BlPaperPale}">
		<Grid Margin="14,10,30,12" ColumnDefinitions="Auto, 12, *">
			<Image Grid.Column="0" Height="44" Width="44"
				   Source="{Binding Icon}" VerticalAlignment="Center" />
			<StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
				<TextBlock Classes="Kicker"
						   Foreground="{DynamicResource BlRedDark}"
						   Text="● &#160;LIVE" />
				<TextBlock FontFamily="Georgia, 'Times New Roman', serif"
						   FontWeight="Bold"
						   FontSize="15"
						   Text="Remote control active" />
				<TextBlock FontSize="11"
						   Foreground="{DynamicResource BlInkMute}"
						   Text="Someone is viewing your screen." />
			</StackPanel>
		</Grid>
	</Border>
</Window>

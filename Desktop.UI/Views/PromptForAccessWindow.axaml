<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BorderLink.Desktop.UI.ViewModels"
		xmlns:fakes="clr-namespace:BorderLink.Desktop.UI.ViewModels.Fakes"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="280"
        x:Class="BorderLink.Desktop.UI.Views.PromptForAccessWindow"
		x:DataType="vm:IPromptForAccessWindowViewModel"
		x:Name="PromptForAccessWindowRef"
        BorderBrush="{DynamicResource BlInk}"
        BorderThickness="1"
        Title="Remote Control Request"
        MinHeight="220"
        MinWidth="320"
        Height="280"
        Width="480"
		Topmost="True"
		ShowActivated="True"
	    WindowStartupLocation="CenterScreen"
        Icon="{Binding WindowIcon}">

	<Design.DataContext>
		<fakes:FakePromptForAccessViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto, *, Auto" Margin="22,18,22,16">

		<StackPanel Grid.Row="0" Spacing="4">
			<TextBlock Classes="Kicker" Text="§ &#160;Permission required" />
			<TextBlock Classes="SectionHeader"
					   FontSize="20"
					   Text="Allow remote control?"
					   TextWrapping="Wrap" />
			<Rectangle Classes="BorderLine" Margin="0,10,0,0" />
		</StackPanel>

		<TextBlock Grid.Row="1"
				   FontSize="14"
				   Margin="0,14,0,0"
				   TextWrapping="Wrap"
				   LineHeight="20"
				   Foreground="{DynamicResource BlInkSoft}"
				   Text="{Binding RequestMessage}" />

		<StackPanel Grid.Row="2"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Spacing="10">
			<Button Width="120"
					Classes="NormalButton"
					Content="Deny"
					Command="{Binding SetResultNo}"
					CommandParameter="{Binding #PromptForAccessWindowRef}" />
			<Button Width="120"
					Content="Allow"
					Command="{Binding SetResultYes}"
					CommandParameter="{Binding #PromptForAccessWindowRef}" />
		</StackPanel>
	</Grid>
</Window>

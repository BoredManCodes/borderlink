@page "/device-details/{deviceId?}/{activeTab?}"

@attribute [Authorize]
@inherits AuthComponentBase


@if (string.IsNullOrWhiteSpace(DeviceId))
{
    <div class="row mt-5">
        <div class="col-md-8 col-lg-6">

            <h3>Device ID:</h3>
            <div class="input-group mb-2">
                <input type="text" class="form-control" placeholder="Enter a device ID to see its details"
                       @bind="_inputDeviceId"
                       @bind:event="oninput"
                       @onkeydown="EvaluateDeviceIdInputKeyDown">
                <div class="input-group-append">
                    <button class="btn btn-primary" @onclick="NavigateToDeviceId">Go</button>
                </div>
            </div>
            <div class="text-muted">
                You can also go directly to a device's details by:
                <ul>
                    <li>Right-clicking a device card on the main page while it's collapsed</li>
                    <li>Clicking the "Open in New Tab" button in a device card's header while it's expanded</li>
                </ul>
            </div>
        </div>
    </div>
}
else if (_isLoading)
{
    <h5>Loading...</h5>
}
else if (_device is null)
{
    <h3>Device not found.</h3>
}
else if (!_userHasAccess)
{
    <h3>Unauthorized.</h3>
}
else
{
    <TabControl InitialActiveTab="@(ActiveTab ?? "device")">
        <TabHeaders>
            <TabHeader Name="device" NavigationUri="@($"/device-details/{DeviceId}/device")">
                Details
            </TabHeader>
            <TabHeader Name="remote-logs" OnActivated="GetRemoteLogs" NavigationUri="@($"/device-details/{DeviceId}/remote-logs")">
                Remote Logs
            </TabHeader>
            <TabHeader Name="script-history" OnActivated="GetScriptHistory" NavigationUri="@($"/device-details/{DeviceId}/script-history")">
                Script History
            </TabHeader>
            <TabHeader Name="apps" OnActivated="LoadInstalledApps" NavigationUri="@($"/device-details/{DeviceId}/apps")">
                Apps
            </TabHeader>
            <TabHeader Name="services" OnActivated="LoadServices" NavigationUri="@($"/device-details/{DeviceId}/services")">
                Services
            </TabHeader>
            <TabHeader Name="processes" OnActivated="LoadProcesses" NavigationUri="@($"/device-details/{DeviceId}/processes")">
                Processes
            </TabHeader>
            <TabHeader Name="patches" OnActivated="LoadPatches" NavigationUri="@($"/device-details/{DeviceId}/patches")">
                Patches
            </TabHeader>
        </TabHeaders>

        <TabContents>
            <TabContent Name="device">
                <div class="col-sm-8 mb-2">
                    <h3 class="mb-3 mt-3">
                        Device Details
                    </h3>

                    <EditForm Model="_device" OnValidSubmit="HandleValidSubmit" @onkeydown="EditFormKeyDown">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        @if (!string.IsNullOrWhiteSpace(_alertMessage))
                        {
                            <AlertBanner Message="@_alertMessage" />
                        }


                        <div class="form-group row">
                            <label for="device-name" class="col-sm-2 col-form-label">Device:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="device-name" readonly value="@_device.DeviceName" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="device-id" class="col-sm-2 col-form-label">Device ID:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="device-id" readonly value="@_device.ID" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-version" class="col-sm-2 col-form-label">Agent Version:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-version" readonly value="@_device.AgentVersion" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-platform" class="col-sm-2 col-form-label">Platform:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-platform" readonly value="@_device.Platform" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-os-description" class="col-sm-2 col-form-label">Platform:</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-os-description" readonly value="@_device.OSDescription" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-storage-percent" class="col-sm-2 col-form-label">
                                Disk:
                                <button type="button" class="btn btn-link p-0 m-0" @onclick="ShowAllDisks" style="font-size: 50%">
                                    (View All)
                                </button>
                            </label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-storage-percent" readonly value="@(MathHelper.GetFormattedPercent(_device.UsedStoragePercent))" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-storage-total" class="col-sm-2 col-form-label">
                                Total Storage:
                            </label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-storage-total" readonly value="@(_device.TotalStorage)" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-memory-percent" class="col-sm-2 col-form-label">
                                Memory:
                            </label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-memory-percent" readonly value="@(MathHelper.GetFormattedPercent(_device.UsedMemoryPercent))" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-memory-total" class="col-sm-2 col-form-label">
                                Total Memory:
                            </label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-memory-total" readonly value="@(_device.TotalMemory)" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-memory-total" class="col-sm-2 col-form-label">
                                Public IP:
                            </label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="agent-memory-total" readonly value="@(_device.PublicIP)" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="agent-memory-total" class="col-sm-2 col-form-label">
                                MAC Addresses:
                            </label>
                            <div class="col-sm-10">
                                <input 
                                    type="text" 
                                    class="form-control" 
                                    name="agent-memory-total" 
                                    readonly
                                       value="@(string.Join(", ", _device.MacAddresses ?? Array.Empty<string>()))" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="device-alias" class="col-sm-2 col-form-label">Device Alias:</label>
                            <div class="col-sm-10">
                                <InputText class="form-control" @bind-Value="@_device.Alias" />
                                <ValidationMessage For="() => _device.Alias" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="device-groups" class="col-sm-2 col-form-label">Device Group:</label>
                            <div class="col-sm-10">
                                <InputSelect @bind-Value="_device.DeviceGroupID" class="form-control">
                                    <option value="">None</option>

                                    @foreach (var group in _deviceGroups)
                                    {
                                        <option @key="group.ID" value="@group.ID">@group.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => _device.DeviceGroupID" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="tags" class="col-sm-2 col-form-label">Tags:</label>
                            <div class="col-sm-10">
                                <InputText @bind-Value="_device.Tags" class="form-control" />
                                <ValidationMessage For="() => _device.Tags" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label for="notes" class="col-sm-2 col-form-label">Notes:</label>
                            <div class="col-sm-10">
                                <InputTextArea @bind-Value="_device.Notes" style="width:100%; height: 10em;"></InputTextArea>
                                <ValidationMessage For="() => _device.Notes" />
                            </div>
                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </EditForm>
                </div>
            </TabContent>

            <TabContent Name="remote-logs">
                <div class="py-3">
                    @if (!_device.IsOnline)
                    {
                        <h5 class="text-center mt-5">Device must be online to retrieve logs.</h5>
                    }
                    else
                    {
                        <div class="mb-2">
                            <button class="btn btn-primary me-2" @onclick="GetRemoteLogs">Refresh</button>
                            <button class="btn btn-danger" @onclick="DeleteLogs">Delete Logs</button>
                        </div>

                        @if (_logLines.Any())
                        {
                            <div style="white-space: pre;">
                                @foreach (var line in _logLines)
                                {
                                    @line
                                }
                            </div>
                        }
                        else
                        {
                            <LoadingSignal />
                        }
                    }

                </div>

            </TabContent>

            <TabContent Name="script-history">

                <h3 class="mb-3 mt-3">
                    Script History
                </h3>
                <table class="table table-dark table-hover table-striped">
                    <thead>
                        <tr>
                            <th>Shell</th>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Duration</th>
                            <th>Input</th>
                            <th>Output</th>
                            <th>Error</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scriptResult in _scriptResults)
                        {
                            <tr>
                                <td>@scriptResult.Shell</td>
                                <td>@scriptResult.TimeStamp</td>
                                <td>@scriptResult.SenderUserName</td>
                                <td>@scriptResult.RunTime</td>
                                <td>@GetTrimmedText(scriptResult.ScriptInput, 25)</td>
                                <td>@GetTrimmedText(scriptResult.StandardOutput, 25)</td>
                                <td>@GetTrimmedText(scriptResult.ErrorOutput, 25)</td>
                                <td>
                                    <button class="btn btn-sm btn-primary" @onclick="() => ShowFullScriptOutput(scriptResult)">Show Full</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </TabContent>

            <TabContent Name="apps">

                <div class="mb-3 mt-3 d-flex flex-wrap align-items-center justify-content-between">
                    <h3 class="mb-0">
                        Installed Software
                        @if (_installedApps is not null)
                        {
                            <span class="text-muted ms-2" style="font-size: 1rem;">
                                (@_installedApps.Count)
                            </span>
                        }
                    </h3>
                    <div class="text-end">
                        <div class="text-muted small">
                            @if (_inventoryCapturedAt is null)
                            {
                                <span>No inventory captured yet.</span>
                            }
                            else
                            {
                                <span>Last captured: @_inventoryCapturedAt.Value.LocalDateTime</span>
                            }
                        </div>
                        <div class="mt-1">
                            <button class="btn btn-outline-primary btn-sm me-2"
                                    disabled="@(!_device.IsOnline)"
                                    title="Search the device's package managers and install a new package"
                                    @onclick="OpenInstallSoftwareModal">
                                <i class="oi oi-plus me-1" aria-hidden="true"></i>
                                <span>Install software...</span>
                            </button>
                            <button class="btn btn-primary btn-sm"
                                    disabled="@_isAppsRefreshing"
                                    @onclick="RefreshInstalledApps">
                                @if (_isAppsRefreshing)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Refreshing...</span>
                                }
                                else
                                {
                                    <i class="oi oi-reload me-1" aria-hidden="true"></i>
                                    <span>Refresh</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_appsRefreshError))
                {
                    <AlertBanner Message="@_appsRefreshError" />
                }

                @if (_installedApps is null && !_isAppsRefreshing)
                {
                    <div class="text-muted">
                        Click <strong>Refresh</strong> to capture an inventory from the agent.
                    </div>
                }
                else if (_installedApps is not null)
                {
                    <div class="mb-2">
                        <input type="search"
                               class="form-control"
                               placeholder="Filter by name, version, publisher..."
                               @bind-value="_appsSearchTerm"
                               @bind-value:event="oninput" />
                    </div>

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th @onclick="@(() => SortApps(InstalledAppSortKey.Name))" style="cursor: pointer;">
                                    Name @SortIndicator(InstalledAppSortKey.Name)
                                </th>
                                <th @onclick="@(() => SortApps(InstalledAppSortKey.Version))" style="cursor: pointer;">
                                    Version @SortIndicator(InstalledAppSortKey.Version)
                                </th>
                                <th @onclick="@(() => SortApps(InstalledAppSortKey.Publisher))" style="cursor: pointer;">
                                    Publisher @SortIndicator(InstalledAppSortKey.Publisher)
                                </th>
                                <th @onclick="@(() => SortApps(InstalledAppSortKey.InstallDate))" style="cursor: pointer;">
                                    Install Date @SortIndicator(InstalledAppSortKey.InstallDate)
                                </th>
                                <th @onclick="@(() => SortApps(InstalledAppSortKey.Source))" style="cursor: pointer;">
                                    Source @SortIndicator(InstalledAppSortKey.Source)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rows = GetFilteredSortedApps();
                            }
                            @if (!rows.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        @if (string.IsNullOrWhiteSpace(_appsSearchTerm))
                                        {
                                            <span>No installed software was reported.</span>
                                        }
                                        else
                                        {
                                            <span>No matches for "@_appsSearchTerm".</span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var app in rows)
                                {
                                    <tr @key="app">
                                        <td>@app.Name</td>
                                        <td>@(app.Version ?? "-")</td>
                                        <td>@(app.Publisher ?? "-")</td>
                                        <td>@(app.InstallDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td><span class="badge bg-secondary">@app.Source</span></td>
                                        <td class="text-end">
                                            @if (!string.IsNullOrWhiteSpace(app.UninstallCommand))
                                            {
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        title="Copy uninstall command"
                                                        @onclick="@(() => CopyUninstallCommand(app))">
                                                    <i class="oi oi-clipboard" aria-hidden="true"></i>
                                                    <span class="ms-1">Copy</span>
                                                </button>
                                            }
                                            @{
                                                var canUninstall = CanUninstallApp(app);
                                                var isPending = _pendingUninstallKeys.Contains(AppKey(app));
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(!_device.IsOnline || !canUninstall || isPending)"
                                                    title="@UninstallButtonTitle(app)"
                                                    @onclick="@(() => OnUninstallClicked(app))">
                                                @if (isPending)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <i class="oi oi-trash me-1" aria-hidden="true"></i>
                                                }
                                                <span>Uninstall</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                <InstallAppModal IsOpen="_isInstallModalOpen"
                                 Device="_device"
                                 OnClose="CloseInstallSoftwareModal"
                                 OnInstallQueued="OnInstallQueued" />

            </TabContent>

            <TabContent Name="services">

                <div class="mb-3 mt-3 d-flex flex-wrap align-items-center justify-content-between">
                    <h3 class="mb-0">
                        Services
                        @if (_services is not null)
                        {
                            <span class="text-muted ms-2" style="font-size: 1rem;">
                                (@_services.Length)
                            </span>
                        }
                    </h3>
                    <div class="text-end">
                        <button class="btn btn-primary btn-sm"
                                disabled="@(_isServicesRefreshing || !_device.IsOnline)"
                                @onclick="RefreshServices">
                            @if (_isServicesRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Refreshing...</span>
                            }
                            else
                            {
                                <i class="oi oi-reload me-1" aria-hidden="true"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_servicesError))
                {
                    <AlertBanner Message="@_servicesError" />
                }

                @if (_services is null && !_isServicesRefreshing)
                {
                    <div class="text-muted">
                        Click <strong>Refresh</strong> to load the service list from the agent.
                    </div>
                }
                else if (_services is not null)
                {
                    <div class="mb-2">
                        <input type="search"
                               class="form-control"
                               placeholder="Filter by name or display name..."
                               @bind-value="_servicesSearchTerm"
                               @bind-value:event="oninput" />
                    </div>

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th @onclick="@(() => SortServices(ServiceSortKey.Name))" style="cursor: pointer;">
                                    Name @ServiceSortIndicator(ServiceSortKey.Name)
                                </th>
                                <th @onclick="@(() => SortServices(ServiceSortKey.DisplayName))" style="cursor: pointer;">
                                    Display Name @ServiceSortIndicator(ServiceSortKey.DisplayName)
                                </th>
                                <th @onclick="@(() => SortServices(ServiceSortKey.Status))" style="cursor: pointer;">
                                    Status @ServiceSortIndicator(ServiceSortKey.Status)
                                </th>
                                <th @onclick="@(() => SortServices(ServiceSortKey.StartType))" style="cursor: pointer;">
                                    Start Type @ServiceSortIndicator(ServiceSortKey.StartType)
                                </th>
                                <th @onclick="@(() => SortServices(ServiceSortKey.ProcessId))" style="cursor: pointer;">
                                    PID @ServiceSortIndicator(ServiceSortKey.ProcessId)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var serviceRows = GetFilteredSortedServices();
                            }
                            @if (!serviceRows.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        @if (string.IsNullOrWhiteSpace(_servicesSearchTerm))
                                        {
                                            <span>No services were reported.</span>
                                        }
                                        else
                                        {
                                            <span>No matches for "@_servicesSearchTerm".</span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var svc in serviceRows)
                                {
                                    <tr @key="svc.Name">
                                        <td>@svc.Name</td>
                                        <td>@(svc.DisplayName ?? "-")</td>
                                        <td><span class="badge @ServiceStatusBadge(svc.Status)">@svc.Status</span></td>
                                        <td>@svc.StartType</td>
                                        <td>@(svc.ProcessId?.ToString() ?? "-")</td>
                                        <td class="text-end">
                                            @{
                                                var pendingKey = svc.Name;
                                                var isPending = _pendingServiceKeys.Contains(pendingKey);
                                                var canStart = svc.Status == ServiceStatus.Stopped;
                                                var canStop = svc.Status == ServiceStatus.Running && svc.CanStop;
                                                var canRestart = svc.Status == ServiceStatus.Running;
                                            }
                                            @if (isPending)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                            }
                                            <button class="btn btn-sm btn-outline-success me-1"
                                                    disabled="@(!_device.IsOnline || !canStart || isPending)"
                                                    title="Start"
                                                    @onclick="@(() => OnServiceActionClicked(svc, "start"))">
                                                <i class="oi oi-media-play" aria-hidden="true"></i>
                                                <span class="ms-1">Start</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger me-1"
                                                    disabled="@(!_device.IsOnline || !canStop || isPending)"
                                                    title="Stop"
                                                    @onclick="@(() => OnServiceActionClicked(svc, "stop"))">
                                                <i class="oi oi-media-stop" aria-hidden="true"></i>
                                                <span class="ms-1">Stop</span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning"
                                                    disabled="@(!_device.IsOnline || !canRestart || isPending)"
                                                    title="Restart"
                                                    @onclick="@(() => OnServiceActionClicked(svc, "restart"))">
                                                <i class="oi oi-reload" aria-hidden="true"></i>
                                                <span class="ms-1">Restart</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

            </TabContent>

            <TabContent Name="processes">

                <div class="mb-3 mt-3 d-flex flex-wrap align-items-center justify-content-between">
                    <h3 class="mb-0">
                        Processes
                        @if (_processes is not null)
                        {
                            <span class="text-muted ms-2" style="font-size: 1rem;">
                                (@_processes.Length)
                            </span>
                        }
                    </h3>
                    <div class="text-end">
                        <button class="btn btn-primary btn-sm"
                                disabled="@(_isProcessesRefreshing || !_device.IsOnline)"
                                @onclick="RefreshProcesses">
                            @if (_isProcessesRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Refreshing...</span>
                            }
                            else
                            {
                                <i class="oi oi-reload me-1" aria-hidden="true"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_processesError))
                {
                    <AlertBanner Message="@_processesError" />
                }

                @if (_processes is null && !_isProcessesRefreshing)
                {
                    <div class="text-muted">
                        Click <strong>Refresh</strong> to load the process list from the agent.
                    </div>
                }
                else if (_processes is not null)
                {
                    <div class="mb-2">
                        <input type="search"
                               class="form-control"
                               placeholder="Filter by name or user..."
                               @bind-value="_processesSearchTerm"
                               @bind-value:event="oninput" />
                    </div>

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th @onclick="@(() => SortProcesses(ProcessSortKey.Pid))" style="cursor: pointer;">
                                    PID @ProcessSortIndicator(ProcessSortKey.Pid)
                                </th>
                                <th @onclick="@(() => SortProcesses(ProcessSortKey.Name))" style="cursor: pointer;">
                                    Name @ProcessSortIndicator(ProcessSortKey.Name)
                                </th>
                                <th @onclick="@(() => SortProcesses(ProcessSortKey.UserName))" style="cursor: pointer;">
                                    User @ProcessSortIndicator(ProcessSortKey.UserName)
                                </th>
                                <th @onclick="@(() => SortProcesses(ProcessSortKey.WorkingSet))" style="cursor: pointer;">
                                    Memory (MB) @ProcessSortIndicator(ProcessSortKey.WorkingSet)
                                </th>
                                <th @onclick="@(() => SortProcesses(ProcessSortKey.Cpu))" style="cursor: pointer;">
                                    CPU % @ProcessSortIndicator(ProcessSortKey.Cpu)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var processRows = GetFilteredSortedProcesses();
                            }
                            @if (!processRows.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">
                                        @if (string.IsNullOrWhiteSpace(_processesSearchTerm))
                                        {
                                            <span>No processes were reported.</span>
                                        }
                                        else
                                        {
                                            <span>No matches for "@_processesSearchTerm".</span>
                                        }
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var proc in processRows)
                                {
                                    <tr @key="proc.Pid">
                                        <td>@proc.Pid</td>
                                        <td>@proc.Name</td>
                                        <td>@(proc.UserName ?? "-")</td>
                                        <td>@FormatMb(proc.WorkingSetBytes)</td>
                                        <td>@(proc.CpuPercent.HasValue ? proc.CpuPercent.Value.ToString("0.0") : "-")</td>
                                        <td class="text-end">
                                            @{
                                                var killPending = _pendingKillPids.Contains(proc.Pid);
                                            }
                                            <button class="btn btn-sm btn-outline-danger"
                                                    disabled="@(!_device.IsOnline || killPending)"
                                                    @onclick="@(() => OnKillProcessClicked(proc))">
                                                @if (killPending)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <i class="oi oi-trash me-1" aria-hidden="true"></i>
                                                }
                                                <span>Kill</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

            </TabContent>

            <TabContent Name="patches">

                <div class="mb-3 mt-3 d-flex flex-wrap align-items-center justify-content-between">
                    <h3 class="mb-0">
                        Pending Updates
                        @if (_pendingPatches is not null)
                        {
                            <span class="text-muted ms-2" style="font-size: 1rem;">
                                (@_pendingPatches.Length)
                            </span>
                        }
                    </h3>
                    <div class="text-end">
                        <button class="btn btn-primary btn-sm"
                                disabled="@(_isPatchesRefreshing || !_device.IsOnline)"
                                @onclick="RefreshPatches">
                            @if (_isPatchesRefreshing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Refreshing...</span>
                            }
                            else
                            {
                                <i class="oi oi-reload me-1" aria-hidden="true"></i>
                                <span>Refresh</span>
                            }
                        </button>
                    </div>
                </div>

                @if (_pendingReboot is not null && _pendingReboot.IsPending)
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>Reboot required.</strong>
                        @if (_pendingReboot.Reasons is { Length: > 0 })
                        {
                            <span> Reasons: @string.Join(", ", _pendingReboot.Reasons)</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_patchesError))
                {
                    <AlertBanner Message="@_patchesError" />
                }

                @if (_pendingPatches is null && !_isPatchesRefreshing)
                {
                    <div class="text-muted">
                        Click <strong>Refresh</strong> to query the agent for pending updates.
                        This can take 30+ seconds on Windows.
                    </div>
                }
                else if (_pendingPatches is not null)
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>KB</th>
                                <th>Severity</th>
                                <th>Size</th>
                                <th>Reboot</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pendingPatches.Length == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No pending updates.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var patch in _pendingPatches)
                                {
                                    var pending = _pendingPatchInstallIds.Contains(patch.Id);
                                    <tr @key="patch.Id">
                                        <td>@patch.Title</td>
                                        <td>@(patch.KbNumber ?? "-")</td>
                                        <td><span class="badge @SeverityBadge(patch.Severity)">@patch.Severity</span></td>
                                        <td>@FormatPatchSize(patch.SizeBytes)</td>
                                        <td>
                                            @if (patch.RebootRequired)
                                            {
                                                <i class="oi oi-warning text-warning" aria-label="Reboot required"></i>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary"
                                                    disabled="@(!_device.IsOnline || pending)"
                                                    @onclick="@(() => OnPatchInstallClicked(patch))">
                                                @if (pending)
                                                {
                                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <i class="oi oi-cloud-download me-1" aria-hidden="true"></i>
                                                }
                                                <span>Install</span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                <h4 class="mb-2 mt-4">Recent Installs</h4>
                @if (_patchHistory is null)
                {
                    <div class="text-muted">Loading history...</div>
                }
                else if (_patchHistory.Length == 0)
                {
                    <div class="text-muted">No patch installs recorded for this device.</div>
                }
                else
                {
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Started</th>
                                <th>Completed</th>
                                <th>Status</th>
                                <th>Reboot</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var run in _patchHistory)
                            {
                                <tr @key="run.Id">
                                    <td>@run.UpdateTitle</td>
                                    <td>@run.StartedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(run.CompletedAt.HasValue ? run.CompletedAt.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm") : "-")</td>
                                    <td><span class="badge @PatchStatusBadge(run.Status)">@run.Status</span></td>
                                    <td>@(run.RebootRequired ? "Yes" : "-")</td>
                                    <td>@(run.Notes ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </TabContent>
        </TabContents>
    </TabControl>
}

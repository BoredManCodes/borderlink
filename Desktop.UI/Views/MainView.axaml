<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BorderLink.Desktop.UI.ViewModels"
			 xmlns:fakes="clr-namespace:BorderLink.Desktop.UI.ViewModels.Fakes"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="420"
             x:Class="BorderLink.Desktop.UI.Views.MainView"
             x:DataType="vm:IMainViewViewModel">

	<Design.DataContext>
		<fakes:FakeMainViewViewModel />
	</Design.DataContext>

	<Grid RowDefinitions="Auto, Auto, *, Auto" Margin="22,18,22,14">

		<!-- Header strip: kicker + product name -->
		<StackPanel Grid.Row="0" Spacing="2">
			<TextBlock Classes="Kicker" Text="§ &#160;Quick Support · Always on top" />
			<TextBlock Classes="SectionHeader" Text="{Binding ProductName}" />
			<Rectangle Classes="BorderLine" Margin="0,12,0,0" />
		</StackPanel>

		<!-- Session ID block -->
		<StackPanel Grid.Row="1" Spacing="6" Margin="0,18,0,16">
			<TextBlock Classes="FieldLabel" Text="YOUR SESSION ID" />
			<TextBox Name="SessionIDTextBox"
					 FontFamily="Consolas, 'Courier New', monospace"
					 FontSize="22"
					 FontWeight="Bold"
					 Padding="10,8"
					 Text="{Binding StatusMessage}"
					 IsReadOnly="True" />

			<Grid ColumnDefinitions="*, Auto" Margin="0,8,0,0">
				<TextBlock Grid.Column="0"
						   Classes="FieldLabel"
						   VerticalAlignment="Center"
						   Text="INVITE LINK" />
				<Button Grid.Column="1"
						Classes="NormalButton"
						Content="Copy link"
						Command="{Binding CopyLinkCommand}" />
			</Grid>
			<TextBlock Foreground="{DynamicResource BlGreen}"
					   FontStyle="Italic"
					   FontSize="12"
					   IsVisible="{Binding IsCopyMessageVisible}"
					   Opacity="{Binding CopyMessageOpacity}"
					   HorizontalAlignment="Right"
					   Text="Copied to clipboard." />
		</StackPanel>

		<!-- Viewers panel -->
		<Grid Grid.Row="2" RowDefinitions="Auto, Auto, *, Auto">
			<TextBlock Grid.Row="0" Classes="FieldLabel" Text="VIEWERS" />
			<Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="2,4,2,4">
				<TextBlock Grid.Column="0" Classes="Kicker" Text="Name" />
				<TextBlock Grid.Column="1" Classes="Kicker" Text="Has Control" />
			</Grid>
			<ListBox Grid.Row="2"
					 Name="ViewerListBox"
					 VerticalAlignment="Stretch"
					 ItemsSource="{Binding Viewers}"
					 SelectionMode="Multiple"
					 SelectedItems="{Binding SelectedViewers}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
							<TextBlock Grid.Column="0"
									   Text="{Binding Name}"
									   VerticalAlignment="Center"
									   TextTrimming="CharacterEllipsis" />
							<CheckBox Grid.Column="1"
									  IsChecked="{Binding HasControl}"
									  VerticalAlignment="Center" />
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<Button Grid.Row="3"
					Classes="NormalButton"
					HorizontalAlignment="Right"
					Margin="0,8,0,0"
					Content="Remove"
					Command="{Binding RemoveViewersCommand}" />
		</Grid>

		<!-- Footer: gear menu -->
		<Grid Grid.Row="3" ColumnDefinitions="Auto, *" Margin="0,12,0,0">
			<Button x:Name="OptionsButton"
					Grid.Column="0"
					Classes="TextButton"
					VerticalAlignment="Center"
					HorizontalAlignment="Left"
					Cursor="Hand"
					Content="⚙  Options"
					FontFamily="Consolas, 'Courier New', monospace"
					FontSize="11"
					Command="{Binding OpenOptionsMenu}"
					CommandParameter="{Binding #OptionsButton}">
				<Button.ContextMenu>
					<ContextMenu>
						<MenuItem Header="Change Server" Command="{Binding ChangeServerCommand}" />
					</ContextMenu>
				</Button.ContextMenu>
			</Button>
			<TextBlock Grid.Column="1"
					   Classes="Kicker"
					   HorizontalAlignment="Right"
					   VerticalAlignment="Center"
					   Text="BorderLink · Border Tech Solutions" />
		</Grid>
	</Grid>
</UserControl>
